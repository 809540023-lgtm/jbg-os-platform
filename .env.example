# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only，勿曝露到 client

# ── Anthropic (Claude) ───────────────────────────────────
ANTHROPIC_API_KEY=
# 模型 id 一律走 packages/harness/src/models.ts 的 MODELS.* 常數；
# 可用下列 env 覆寫預設（不填則用 models.ts 內建預設）。id 請查 claude-api skill 確認最新值。
MODEL_REASONING=
MODEL_VISION=
MODEL_FAST=

# ── Embedding ────────────────────────────────────────────
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ── Connectors ───────────────────────────────────────────
# Google Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_WATCH_FOLDER_ID=       # 監看的商品照片資料夾

# Facebook Graph
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=                # webhook 簽章驗證

# LINE
LINE_NOTIFY_TOKEN=                  # 或 Messaging API
LINE_CHANNEL_ACCESS_TOKEN=

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
